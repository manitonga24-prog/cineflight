<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d0f14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mi_lay_titre"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#e8ecf2"
            android:paddingBottom="14dp" />

        <!-- Adresse serveur -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#8b95a5" android:textSize="13sp"
            android:paddingTop="14dp" android:paddingBottom="4dp"
            android:text="@string/mi_lay_serveur" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText android:id="@+id/inpServeur"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#e8ecf2" android:textColorHint="#6b7280"
                android:hint="http://192.168.50.118:8095"
                android:inputType="textUri" android:textSize="14sp" />
            <Button android:id="@+id/btnRecharger"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="↻" android:textSize="18sp"
                android:backgroundTint="#26a69a" />
        </LinearLayout>

        <!-- Étape 1 : formation -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#8b95a5" android:textSize="13sp"
            android:paddingTop="14dp" android:paddingBottom="4dp"
            android:text="@string/mi_lay_etape1" />
        <Spinner android:id="@+id/spFormation"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:backgroundTint="#4db6ac" />

        <!-- Étape 2 : chanson -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#8b95a5" android:textSize="13sp"
            android:paddingTop="14dp" android:paddingBottom="4dp"
            android:text="@string/mi_lay_etape2" />
        <Spinner android:id="@+id/spChanson"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:backgroundTint="#4db6ac" />

        <!-- Étape 3 : passe -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#8b95a5" android:textSize="13sp"
            android:paddingTop="14dp" android:paddingBottom="4dp"
            android:text="@string/mi_lay_etape3" />
        <Spinner android:id="@+id/spAngle"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:backgroundTint="#4db6ac" />

        <!-- Détail des prises de la passe choisie -->
        <TextView android:id="@+id/txtChanson"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="—" android:textColor="#e8ecf2" android:textSize="14sp"
            android:padding="12dp" android:background="#1d222c"
            android:layout_marginTop="6dp" android:fontFamily="monospace" />

        <!-- Récap -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#8b95a5" android:textSize="13sp"
            android:paddingTop="14dp" android:paddingBottom="4dp"
            android:text="@string/mi_lay_recap" />
        <TextView android:id="@+id/txtRecap"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="—" android:textColor="#e8ecf2" android:textSize="15sp"
            android:padding="12dp" android:background="#1d222c"
            android:fontFamily="monospace" />

        <!-- Sécurité -->
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/mi_lay_avert"
            android:textColor="#ffd699" android:textSize="13sp"
            android:padding="12dp" android:layout_marginTop="10dp"
            android:background="#1a1410" />

        <!-- IP téléphone -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#8b95a5" android:textSize="13sp"
            android:paddingTop="14dp" android:paddingBottom="4dp"
            android:text="@string/mi_lay_ip" />
        <EditText android:id="@+id/inpIp"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="192.168.50.230" android:inputType="text"
            android:textColor="#e8ecf2" android:textSize="15sp" />

        <!-- Boutons -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="14dp">
            <Button android:id="@+id/btnSimu"
                android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1" android:layout_marginEnd="6dp"
                android:text="@string/mi_lay_simuler" android:textStyle="bold"
                android:textColor="#ffffff" android:backgroundTint="#26a69a" />
            <Button android:id="@+id/btnReel"
                android:layout_width="0dp" android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/mi_lay_reel" android:textStyle="bold"
                android:textColor="#ffffff" android:backgroundTint="#e53935" />
        </LinearLayout>

        <!-- Résultat -->
        <TextView android:id="@+id/txtResultat"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="#a5d6a7" android:textSize="14sp"
            android:padding="12dp" android:layout_marginTop="12dp"
            android:background="#10261a" />

    </LinearLayout>
</ScrollView>
