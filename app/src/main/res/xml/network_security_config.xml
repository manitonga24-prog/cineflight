<?xml version="1.0" encoding="utf-8"?>
<!--
  Politique reseau CineFlight.

  Le serveur distant cineflight.ca est desormais joint UNIQUEMENT en HTTPS
  (chiffre) : mot de passe, JWT et cle de diffusion protegees en transit.

  Le trafic HTTP EN CLAIR n'est autorise QUE vers le serveur local LAN
  192.168.50.118 (station au sol / test terrain, sans certificat public),
  utilise par MissionActivity et PlacementActivity. Tout le reste est en
  HTTPS securise par defaut.

  Reference dans AndroidManifest.xml, balise <application ...> :
      android:networkSecurityConfig="@xml/network_security_config"
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.50.118</domain>
    </domain-config>
</network-security-config>
